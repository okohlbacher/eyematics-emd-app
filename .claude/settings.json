{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run test:ci)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run knip)",
      "Bash(npm run test:acceptance:*)",
      "Bash(npx vitest run:*)",
      "Bash(npm run requirements:*)",
      "Bash(node scripts/useavibe/activate.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(/../data/**)",
      "Read(/../study/**)",
      "Edit(/docs/Pflichtenheft.md)",
      "Edit(/docs/Lastenheft.md)",
      "Edit(/acceptance/**)",
      "Edit(/handoff/requirements/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/useavibe/hook-session-start.mjs\"", "timeout": 15 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/useavibe/hook-protect.mjs\"", "timeout": 20 } ] },
      { "matcher": "Read|Grep|Glob|Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/useavibe/hook-data-deny.mjs\"", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/useavibe/gate.sh\"", "timeout": 1200 } ] }
    ]
  }
}
